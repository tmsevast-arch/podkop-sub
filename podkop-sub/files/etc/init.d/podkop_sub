#!/bin/sh /etc/rc.common
# Расписание podkop-sub в cron: ночное обновление подписок и проверка живых серверов.
# Демона нет: procd нужен ради триггера на изменение /etc/config/podkop_sub.

START=99
USE_PROCD=1

CRON=/etc/crontabs/root
MARK='# podkop-sub'

cron_remove() {
	[ -f "$CRON" ] && sed -i "/$MARK\$/d" "$CRON"
}

cron_reload() {
	/etc/init.d/cron restart >/dev/null 2>&1
}

num() {
	local v
	v="$(uci -q get "podkop_sub.settings.$1")"
	case "$v" in
		''|*[!0-9]*) echo "$2" ;;
		*) echo "$v" ;;
	esac
}

start_service() {
	cron_remove
	if [ "$(uci -q get podkop_sub.settings.enabled)" != 0 ]; then
		local hour m check
		hour="$(num update_hour 4)"
		[ "$hour" -le 23 ] || hour=4
		# случайная минута, чтобы роутеры не ходили к провайдеру одновременно
		m="$(awk 'BEGIN { srand(); print int(rand() * 60) }')"
		mkdir -p "${CRON%/*}"
		echo "$m $hour * * * /usr/bin/podkop-sub update >/dev/null 2>&1 $MARK" >> "$CRON"

		check="$(num check_interval 10)"
		[ "$check" -gt 0 ] && [ "$check" -le 60 ] &&
			echo "*/$check * * * * /usr/bin/podkop-sub check >/dev/null 2>&1 $MARK" >> "$CRON"
	fi
	cron_reload
}

# после «Применить» в LuCI: расписание + ручные ссылки и смена секций в Podkop
reload_service() {
	start_service
	/usr/bin/podkop-sub apply </dev/null >/dev/null 2>&1 &
}

stop_service() {
	cron_remove
	cron_reload
}

service_triggers() {
	procd_add_reload_trigger podkop_sub
}
